    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Estado detalhado dos alertas direto do Prometheus (métrica ALERTS). Funciona mesmo sem o Alertmanager no ar.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value #firing" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "red", "value": 1 }] } }] }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
