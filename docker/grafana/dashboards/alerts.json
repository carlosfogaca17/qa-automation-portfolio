      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "exemplar": true,
          "expr": "sum by (alertname, alertstate, severity, category) (ALERTS)",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Estado dos alertas (Prometheus)",
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "indexByName": {}, "renameByName": { "Value": "Ativo", "alertname": "Alerta", "alertstate": "Estado", "category": "Categoria", "severity": "Severidade" } } }
      ],
      "type": "table"
    }
