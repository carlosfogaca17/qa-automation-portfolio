# Estrutura de variáveis — apenas exemplos/placeholders.
# Copie para `.env` (mesma pasta) e preencha com os valores reais.
# O arquivo `.env` NÃO é versionado (ver .gitignore).

# PostgreSQL
POSTGRES_USER=qa_user
POSTGRES_PASSWORD=qa_password
POSTGRES_DB=qa_portfolio
POSTGRES_PORT=5432

# Observabilidade — Prometheus / Grafana / Exporter
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
EXPORTER_PORT=9101

# API local (alvo do k6) — ServeRest
SERVEREST_PORT=3000

# Alertmanager (notificações por e-mail — só com o profile 'alerting')
ALERTMANAGER_PORT=9093

# Servidor e Autenticação SMTP do Brevo
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=SEU_USUARIO_SMTP_AQUI
SMTP_PASS=SUA_CHAVE_SMTP_GERADA_AQUI
# Exige TLS (STARTTLS) na conexão SMTP.
SMTP_REQUIRE_TLS=true

# Remetente e Destinatário das notificações
SMTP_FROM=seu-remetente@exemplo.com
ALERT_RECEIVER_EMAIL=seu-destinatario@exemplo.com
