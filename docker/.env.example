# Exemplo de variáveis de ambiente para o Docker Compose.
# Copie para `.env` e ajuste conforme necessário.

# PostgreSQL
POSTGRES_USER=qa_user
POSTGRES_PASSWORD=qa_password
POSTGRES_DB=qa_portfolio
POSTGRES_PORT=5432

# Observabilidade — Prometheus / Grafana / Exporter
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
EXPORTER_PORT=9101

# API local (alvo do k6) — ServeRest
SERVEREST_PORT=3000

# Alertmanager (notificações por e-mail via SMTP)
# Só é usado com o profile 'alerting':
#   docker compose --profile alerting up -d alertmanager
#   (ou npm run alerting:up)
ALERTMANAGER_PORT=9093
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_FROM=alertmanager@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true
ALERT_EMAIL_TO=qa-team@example.com

